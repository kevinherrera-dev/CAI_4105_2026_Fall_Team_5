<mxfile host="app.diagrams.net">
  <diagram name="Challenge 1" id="ch1">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;Challenge 1: Predict Apartment Rent&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Learn from apartments WITH rent, then guess rent for apartments WITHOUT it. Lower RMSE wins.&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1400" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="train" value="📘 &lt;b&gt;challenge1_train.csv&lt;/b&gt; (7,398 apartments, price INCLUDED)&lt;br&gt;= homework. Use it for everything: learning, testing, tuning.&lt;br&gt;Target column = &lt;b&gt;price&lt;/b&gt;. Never use &lt;b&gt;ID&lt;/b&gt; as a clue." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="0" y="80" width="460" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="test" value="🔒 &lt;b&gt;challenge1_test.csv&lt;/b&gt;&lt;br&gt;(2,467 apartments, price HIDDEN)&lt;br&gt;= final exam. ONLY use it in step 6." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1190" y="80" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b style='font-size:15px'&gt;1. 🔍 EXPLORE and PREPARE&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Look at the columns (numbers vs words)&lt;br&gt;• Fill blanks (imputer)&lt;br&gt;• Words → 0/1 columns (one-hot)&lt;br&gt;• Scale numbers (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="0" y="210" width="210" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b style='font-size:15px'&gt;2. ⚖️ SET UP FAIR TESTING&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 5-fold cross-validation on the TRAIN file&lt;br&gt;• Grade with &lt;b&gt;RMSE&lt;/b&gt; (typical $ miss, lower = better)&lt;br&gt;• Pipeline = no leakage&lt;br&gt;• Same test for every model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d79b00;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="238" y="210" width="210" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b style='font-size:15px'&gt;3. 🤖 TRY 4 MODELS&lt;/b&gt;&lt;br&gt;&lt;br&gt;📏 Linear Regression&lt;br&gt;🌳 Decision Tree&lt;br&gt;🌲 Random Forest&lt;br&gt;🚀 Gradient Boosting (XGBoost)&lt;br&gt;&lt;br&gt;→ put their RMSEs in a &lt;b&gt;table&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="476" y="210" width="210" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b style='font-size:15px'&gt;4. 🎛️ IMPROVE&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Grid Search&lt;/b&gt;: try combos of settings, keep the lowest RMSE&lt;br&gt;• Optional: make new clues (feature engineering)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="714" y="210" width="210" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&lt;b style='font-size:15px'&gt;5. 🏆 PICK THE WINNER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Explain why in a few sentences:&lt;br&gt;• lowest RMSE&lt;br&gt;• not overfitting&lt;br&gt;• complexity / speed&lt;br&gt;• easy to explain?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="952" y="210" width="210" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="&lt;b style='font-size:15px'&gt;6. 📤 PREDICT&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Retrain the winner on ALL the train data&lt;br&gt;• Predict price for the test file&lt;br&gt;• Save the results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1190" y="210" width="210" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="pred" value="📄 &lt;b&gt;predictions.csv&lt;/b&gt;&lt;br&gt;2 columns: ID, price&lt;br&gt;2,467 rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1190" y="430" width="210" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="&lt;b style='font-size:15px'&gt;📦 PUT IN YOUR TEAM'S GITHUB REPO&lt;/b&gt;&lt;br&gt;&lt;br&gt;☐ &lt;b&gt;Jupyter notebook&lt;/b&gt;: runs top to bottom, steps 1 → 6&lt;br&gt;☐ &lt;b&gt;predictions.csv&lt;/b&gt;&lt;br&gt;☐ &lt;b&gt;README.md&lt;/b&gt;: short summary (approach, validation, models, winner, its RMSE)&lt;br&gt;☐ &lt;b&gt;requirements.txt&lt;/b&gt;: list of libraries so anyone can rerun it&lt;br&gt;☐ &lt;b&gt;Your own commits&lt;/b&gt;: GitHub activity = proof you took part&lt;br&gt;☐ &lt;b&gt;Peer-review form&lt;/b&gt;: each person submits their own" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="0" y="430" width="1162" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="rules" value="🚫 &lt;b&gt;RULES:&lt;/b&gt; all 4 models required · tune ONLY on the train file · test file only for final predictions · no outside data · don't share with other teams · set random_state=42 so it's reproducible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="0" y="625" width="1400" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="e0" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="train" target="s1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="endArrow=block;html=1;strokeWidth=3;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeWidth=3;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeWidth=3;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeWidth=3;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;strokeWidth=3;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="only now!" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#b85450;fontColor=#b85450;fontSize=11;fontStyle=1;" edge="1" parent="1" source="test" target="s6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="s6" target="pred">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="pred" target="sub">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
