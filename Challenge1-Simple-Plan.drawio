<mxfile host="app.diagrams.net">
  <diagram name="Simple Plan" id="simple">
    <mxGraphModel dx="900" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Challenge 1: Predict apartment rent (price)&lt;/b&gt;&lt;br&gt;Learn from train.csv → guess prices for test.csv" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="800" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;1. Clean the data&lt;/b&gt;&lt;br&gt;Fill blanks, turn word columns into 0/1&lt;br&gt;(use train.csv only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Set up testing&lt;/b&gt;&lt;br&gt;5-fold cross-validation&lt;br&gt;Score = RMSE (lower is better)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="320" y="90" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Try 4 models&lt;/b&gt;&lt;br&gt;Linear Regression, Decision Tree,&lt;br&gt;Random Forest, XGBoost&lt;br&gt;→ table of RMSEs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Tune them&lt;/b&gt;&lt;br&gt;GridSearchCV to find best settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="240" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Pick the winner&lt;/b&gt;&lt;br&gt;Lowest RMSE, not overfitting.&lt;br&gt;Write a few sentences why." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="320" y="240" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. Predict&lt;/b&gt;&lt;br&gt;Train winner on all of train.csv,&lt;br&gt;predict test.csv →&lt;br&gt;predictions.csv (ID, price)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="240" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="turnin" value="&lt;b&gt;Turn in (GitHub repo)&lt;/b&gt;&lt;br&gt;☐ Notebook that runs top to bottom&lt;br&gt;☐ predictions.csv&lt;br&gt;☐ README.md (short summary)&lt;br&gt;☐ requirements.txt&lt;br&gt;☐ Everyone: own commits + peer review form" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="380" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;Don't lose points&lt;/b&gt;&lt;br&gt;✗ Never tune or peek using test.csv&lt;br&gt;✗ Don't use ID as a feature&lt;br&gt;✓ Do all 4 models&lt;br&gt;✓ random_state=42 everywhere&lt;br&gt;✓ Preprocessing + model in one Pipeline" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="460" y="380" width="380" height="130" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
